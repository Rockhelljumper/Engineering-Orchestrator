# eo-anchor: the only writer of the rollback anchor on /srv/eo-anchor.
[Unit]
Description=eo rollback-anchor service
Requires=eo-anchor.socket eo-anchor-admin.socket
After=eo-anchor.socket eo-anchor-admin.socket
RequiresMountsFor=/srv/eo-anchor

[Service]
Type=simple
User=eo-anchor
Group=eo-anchor
Sockets=eo-anchor.socket eo-anchor-admin.socket
ExecStart=/usr/bin/python3 -I /opt/eo/services/anchor/eo_anchor.py --state-dir /srv/eo-anchor --controller-user eo --admin-uid 0
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/eo-anchor
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
